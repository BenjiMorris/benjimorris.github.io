Cell[BoxData[{
 RowBox[{
  RowBox[{"AdjacencyQ", "[", 
   RowBox[{"v_", ",", "e_"}], "]"}], ":=", 
  RowBox[{"MemberQ", "[", 
   RowBox[{
    RowBox[{"VertexList", "[", 
     RowBox[{"{", "e", "}"}], "]"}], ",", "v"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ADJACENCYQ", "[", 
   RowBox[{"V_", ",", "e_"}], "]"}], ":=", 
  RowBox[{"AnyTrue", "[", 
   RowBox[{"V", ",", 
    RowBox[{
     RowBox[{"AdjacencyQ", "[", 
      RowBox[{"#", ",", "e"}], "]"}], "&"}]}], "]"}]}]}], "Code",
