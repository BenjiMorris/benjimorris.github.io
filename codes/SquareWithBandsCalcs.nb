    "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "i_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "==", "0"}], ",", 
        RowBox[{"N", "+", "k"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
