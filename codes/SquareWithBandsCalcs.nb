            RowBox[{
             RowBox[{"2", "*", "i"}], "+", "1"}]}], "}"}]}], "}"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"2", "*", "n"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "4"}], "*", "n"}], "-", "1"}], ",", "0"}], "}"}], 
         ",", 
