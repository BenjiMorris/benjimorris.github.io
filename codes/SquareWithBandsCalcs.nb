Cell[BoxData[{
 RowBox[{
  RowBox[{"band", "[", 
   RowBox[{"n_", ",", 
    RowBox[{"{", 
     RowBox[{"t_", ",", "i_", ",", "j_", ",", "k_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"t", "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r1", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "j"}], "+", "1", "-", 
            RowBox[{"2", "*", "i"}]}], ")"}], "/", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"r2", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "j"}], "-", "1", "-", 
            RowBox[{"2", "*", "i"}]}], ")"}], "/", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "*", "i"}], "-", "1"}], ",", 
           RowBox[{
            RowBox[{"2", "*", "j"}], "-", "1"}]}], "]"}], "+", 
         RowBox[{"Max", "[", 
          RowBox[{"r1", ",", "r2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{"White", ",", 
          RowBox[{"Thickness", "[", 
           RowBox[{"0.2", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"4", "*", "n"}], "+", "1"}], ")"}], "/", "4"}], 
             ")"}]}], "]"}], ",", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "c"}], "}"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"r1", "+", "r2"}], ")"}], "/", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "Black", ",", 
          RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "c"}], "}"}], ",", "r1", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "c"}], "}"}], ",", "r2", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "Blue", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Circle", "[", 
