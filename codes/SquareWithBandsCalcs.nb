      RowBox[{"N1s", "=", 
       RowBox[{"Total", "[", "CS", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SC", "=", 
       RowBox[{"sc", "*", 
        RowBox[{"LP2s", "^", 
         RowBox[{"(", 
          RowBox[{"L", "-", "N1s"}], ")"}]}], "*", 
        RowBox[{"LP1s", "^", 
         RowBox[{"(", "N1s", ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Vnew", "=", 
       RowBox[{"VertexList", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"G", ",", 
          RowBox[{"Flatten", "[", "CC", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Vtab", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"Vnew", ",", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"GV", "[", "i", "]"}], ",", "#"}], "]"}], "&"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"2", "*", "n"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Newthru", "=", 
       RowBox[{"Length", "/@", "Vtab"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"CDreps", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ev", "[", 
              RowBox[{"Vtab", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "->", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Newthru", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"2", "*", "n"}]}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bdnew", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ReplacePart", "[", 
           RowBox[{"#", ",", 
            RowBox[{"4", "->", " ", 
             RowBox[{"Newthru", "[", 
              RowBox[{"[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], "]"}], 
          ")"}], "&"}], "/@", "BD"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cdnew", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"CD", ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "CC", "]"}], ",", 
              RowBox[{"v", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ")"}]}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cdnew", "=", 
       RowBox[{"cdnew", "/.", "CDreps"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
       "SC", ",", "N", ",", "M", ",", "n", ",", "bdnew", ",", "cdnew"}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}]], "Code",
