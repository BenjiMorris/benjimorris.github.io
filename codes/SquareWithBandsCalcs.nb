   3.909483144937845*^9}, {3.9094831794322352`*^9, 3.9094834216136813`*^9}, {
   3.9094834982781677`*^9, 3.9094835056957183`*^9}, {3.909483556516751*^9, 
   3.9094835703344965`*^9}, {3.9094843516111774`*^9, 
