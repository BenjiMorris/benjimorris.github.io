              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"i", ",", "j"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"i", "-", "1"}], ",", 
                   RowBox[{
                    RowBox[{"f", "[", 
                    RowBox[{"i", "-", "1"}], "]"}], "+", "1", "-", "j"}]}], 
                  "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"2", "*", "n"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
         ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"2", "*", "n"}], "+", "1"}], ",", 
               RowBox[{"M", "+", "k", "+", "1", "-", "j"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", "*", "n"}], ",", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"2", "*", "n"}], "]"}], "+", "1", "-", "j"}]}], 
              "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Shiftmid", "[", 
             RowBox[{"k", ",", "n", ",", "#"}], "]"}], "&"}], ",", "CD", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]}], "Code",
