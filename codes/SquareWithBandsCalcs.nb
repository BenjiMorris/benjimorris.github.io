Cell[BoxData[
 RowBox[{
  RowBox[{"Mult", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sc2_", ",", "N2_", ",", "M2_", ",", "n2_", ",", "\[IndentingNewLine]", 
      "BD2_", ",", "\[IndentingNewLine]", "CD2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "sc1_", ",", "N1_", ",", "M1_", ",", "n1_", ",", "\[IndentingNewLine]", 
      "BD1_", ",", "\[IndentingNewLine]", "CD1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"M1", "!=", "N2"}], ",", "\[IndentingNewLine]", "\"\<N/A\>\"", 
    ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sc", ",", "N", ",", "M", ",", "n", ",", "BD", ",", "f", ",", "G1", 
        ",", "G2", ",", "Vreps", ",", "inv", ",", "G", ",", "NG", ",", "cd1", 
        ",", "cd2", ",", "lv", ",", "CDV", ",", "conQ", ",", "cdnew", ",", 
        "CD", ",", "l", ",", "ev"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"N", "=", "N1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", "=", "M2"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"n1", "+", "n2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"BD", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"BD1", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "+", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"2", "*", "n1"}], ",", 
                RowBox[{"2", "*", "n1"}], ",", "0"}], "}"}]}], ")"}], "&"}], "/@",
            "BD2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"f", "[", "i_", "]"}], ":=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"i", "==", "0"}], ",", "N2", ",", 
          RowBox[{"i", "==", 
           RowBox[{
            RowBox[{"2", "*", "n2"}], "+", "1"}]}], ",", "M2", ",", 
          RowBox[{"0", "<", "i", "<", 
           RowBox[{
            RowBox[{"2", "*", "n2"}], "+", "1"}]}], ",", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{"BD2", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "==", "i"}], "||", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "==", "i"}]}], ")"}], 
              "&"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "4"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"G1", "=", 
        RowBox[{"Grph", "[", 
         RowBox[{"{", 
          RowBox[{
          "sc1", ",", "N1", ",", "M1", ",", "n1", ",", "BD1", ",", "CD1"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Vreps", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"v", "[", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], "]"}], "->", 
              RowBox[{"v", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"2", "*", "n1"}], "+", "2", "+", "i"}], ",", "j"}], 
                "}"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"f", "[", "i", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{
              RowBox[{"2", "*", "n2"}], "+", "1"}]}], "}"}]}], "]"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"inv", "[", 
         RowBox[{"v", "[", 
          RowBox[{"{", 
           RowBox[{"i_", ",", "j_"}], "}"}], "]"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "<", 
           RowBox[{
            RowBox[{"2", "*", "n1"}], "+", "1"}]}], ",", 
          RowBox[{"v", "[", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}], "]"}], ",", 
          RowBox[{"v", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "-", "2"}], ",", "j"}], "}"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ev", "[", 
         RowBox[{"v", "[", 
          RowBox[{"{", 
           RowBox[{"i_", ",", "j_"}], "}"}], "]"}], "]"}], ":=", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"G2", "=", 
        RowBox[{"Grph", "[", 
         RowBox[{"{", 
          RowBox[{
          "sc2", ",", "N2", ",", "M2", ",", "n2", ",", "BD2", ",", "CD2"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"G2", "=", 
        RowBox[{"VertexReplace", "[", 
         RowBox[{"G2", ",", "Vreps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"G", "=", 
        RowBox[{"EdgeAdd", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphUnion", "[", 
           RowBox[{"G1", ",", "G2"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "*", "n1"}], "+", "1"}], ",", "i"}], "}"}], 
              "]"}], "\[UndirectedEdge]", 
             RowBox[{"v", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "*", "n1"}], "+", "2"}], ",", "i"}], "}"}], 
              "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "M1"}], "}"}]}], "]"}]}], "]"}]}], 
       ";", "\n", 
       RowBox[{"NG", "=", 
        RowBox[{"Graph", "[", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"EdgeList", "[", "G", "]"}], ",", 
           RowBox[{
            RowBox[{"ADJACENCYQ", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"v", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "*", "n1"}], "+", "1"}], ",", "i"}], "}"}], 
                    "]"}], ",", 
                   RowBox[{"v", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "*", "n1"}], "+", "2"}], ",", "i"}], "}"}], 
                    "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", "M1"}], "}"}]}], "]"}], "]"}], 
              ",", "#"}], "]"}], "&"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"l", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"FindFundamentalCycles", "[", "NG", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sc", "=", 
        RowBox[{
         RowBox[{"\[Alpha]", "^", "l"}], "*", "sc1", "*", "sc2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"NG", "=", 
          RowBox[{"EdgeContract", "[", 
           RowBox[{"NG", ",", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "*", "n1"}], "+", "1"}], ",", "i"}], "}"}], 
              "]"}], "\[UndirectedEdge]", 
             RowBox[{"v", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "*", "n1"}], "+", "2"}], ",", "i"}], "}"}], 
              "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "M1"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cd1", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"CD1", ",", 
          RowBox[{
           RowBox[{"\[Not]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", 
               RowBox[{
                RowBox[{"2", "*", "n1"}], "+", "1"}]}], "||", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}], "==", 
               RowBox[{
                RowBox[{"2", "*", "n1"}], "+", "1"}]}]}], ")"}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cd2", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"CD2", ",", 
          RowBox[{
           RowBox[{"\[Not]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "0"}], "||", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}], "==", "0"}]}], 
             ")"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cd2", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "+", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", "*", "n1"}], ",", "0"}], "}"}]}], ")"}], "&"}], 
          ",", "cd2", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"CDV", "=", 
        RowBox[{"VertexList", "[", 
         RowBox[{"VertexDelete", "[", 
          RowBox[{"NG", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "*", "n1"}], "+", "1"}], ",", "i"}], "}"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "M1"}], "}"}]}], "]"}]}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lv", "=", 
        RowBox[{"Length", "[", "CDV", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"CDV", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"CDV", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"CDV", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"j", "+", "1"}], ",", "lv"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"lv", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"conQ", "[", "U_", "]"}], ":=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{
          RowBox[{"ConnectedComponents", "[", "NG", "]"}], ",", 
          RowBox[{
           RowBox[{"SubsetQ", "[", 
            RowBox[{"#", ",", "U"}], "]"}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cdnew", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"ev", "@*", "inv"}], ",", 
          RowBox[{"Select", "[", 
           RowBox[{"CDV", ",", 
            RowBox[{
             RowBox[{"conQ", "[", "#", "]"}], "&"}]}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"CD", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"cd1", ",", "cd2", ",", "cdnew"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sc", ",", "N", ",", "M", ",", "n", ",", "BD", ",", "CD"}], 
        "}"}]}]}], "]"}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.90948145879329*^9, 3.909481805808687*^9}, {
   3.909481837544963*^9, 3.909481878994067*^9}, {3.909481925448449*^9, 
