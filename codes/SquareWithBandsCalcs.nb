        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"i", ",", 
          RowBox[{
           RowBox[{"2", "*", "n"}], "+", "1"}]}], "]"}]}], ")"}]}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Il", "[", "k_", "]"}], "[", 
