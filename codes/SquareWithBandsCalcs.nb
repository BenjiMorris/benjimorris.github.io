Cell["Surface Temperley-Lieb Diagrams", "Subsection",
 CellChangeTimes->{{3.916204501304001*^9, 
  3.9162045219884663`*^9}},ExpressionUUID->"5a16bab4-3d1b-4973-b140-\
6c28a666c6d4"],

Cell["\<\
Instead of now drawing our diagrams inside a square frame which is a very \
simple surface, let us \[OpenCurlyDoubleQuote]play the game\
\[CloseCurlyDoubleQuote]  of drawing diagrams on different surface types (we \
will add the condition that they have one boundary component). We will do \
this by keeping the square frame and adding some handles on the right hand \
edge: the two simplest such surfaces are the following \
\>", "Text",
 CellChangeTimes->{{3.9162045450217056`*^9, 
  3.916204712871563*^9}},ExpressionUUID->"3266bffb-f06c-4244-acff-\
3f5250135157"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "2", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "3", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2", ",", "4", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"{", 
