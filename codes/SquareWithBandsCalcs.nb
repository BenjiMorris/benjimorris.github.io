    "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"sc", ",", 
    RowBox[{"N", "+", "k"}], ",", 
    RowBox[{"M", "+", "k"}], ",", "n", ",", "BD", ",", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "j"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "*", "n"}], "+", "1"}], ",", "j"}], "}"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
      RowBox[{"Map", "[", 
