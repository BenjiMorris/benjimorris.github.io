Cell[BoxData[{
 RowBox[{
  RowBox[{"Shiftend", "[", 
   RowBox[{"k_", ",", "n_", ",", 
    RowBox[{"{", 
     RowBox[{"i_", ",", "j_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], "+", 
   RowBox[{"{", 
