  3.892830844292351*^9, 3.8928310995118027`*^9}, {3.8928311553787966`*^9, 
  3.892831157071843*^9}, {3.8928916230540276`*^9, 
  3.892891624591834*^9}},ExpressionUUID->"bb23cfd0-b484-4d71-a739-\
19b0eafb4fd9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ex2Data", "=", 
   RowBox[{
    RowBox[{"Hslide", "[", 
     RowBox[{"3", ",", "\"\<d\>\""}], "]"}], "[", "ex1Data", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "ex2Data", "\[IndentingNewLine]", 
