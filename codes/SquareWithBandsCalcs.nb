        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "+", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0", ",", 
             RowBox[{"2", "*", "k"}]}], "}"}]}], ")"}], "&"}], "/@", "BD"}], 
       ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
