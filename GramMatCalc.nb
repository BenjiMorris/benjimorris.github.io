Notebook[{
Cell[TextData[{
 "For rank n, height l, the standard ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", 
    RowBox[{"l", ",", "n"}]], TraditionalForm]],ExpressionUUID->
  "34ae361b-6ac3-42a5-8441-99fac6f69b44"],
 "-module ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    RowBox[{"p", ",", "\[Lambda]"}]], TraditionalForm]],ExpressionUUID->
  "17af7c2f-6066-4757-b799-add4e4acb231"],
 " with p propagating lines, and partition \[Lambda] of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "l"], ":=", 
    RowBox[{"min", "(", 
     RowBox[{"p", ",", 
      RowBox[{"l", "+", "2"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "c3e8e317-bb84-44bf-ada4-235aca6ef319"],
 ", has a basis which can be described by a collection (n-p)/2 \
\[OpenCurlyDoubleQuote]cups\[CloseCurlyDoubleQuote] (i.e. order two subsets \
of {1,...,n}), such that the (class of) half-diagram it describes has height \
\[LessEqual]l, and a basis element of the Specht module ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "c72b9b69-3b9e-416c-8a1b-4782717a54a7"],
 " which can be written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "\[CenterDot]", " ", 
    SubscriptBox["e", "\[Lambda]"]}], TraditionalForm]],ExpressionUUID->
  "deb0c0fa-854e-4463-b5a9-eefb8e845f17"],
 " for some permutation \[Sigma] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sym", "(", 
    SubscriptBox["p", "l"]}], TraditionalForm]],ExpressionUUID->
  "a4463285-477a-4ba6-8fe8-4f273539c3db"],
 "). Thus we record such basis elements by a pair:\n{Cups , Perm}, where Cups \
is a list of \[OpenCurlyDoubleQuote]cups\[CloseCurlyDoubleQuote], and Perm is \
a permutation (described as a permutation list). The function PermCalc[n,L,U] \
computes the permutation \[Sigma] in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sym", "(", 
    SubscriptBox["p", "l"]}], TraditionalForm]],ExpressionUUID->
  "2b320338-223c-4ce7-8647-a22fdfbd41fd"],
 "), and the integer d (the number of internal components), such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["U", "*"], "\[CenterDot]", "L"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Delta]", "d"], 
      RowBox[{
       SubscriptBox["e", "\[Lambda]"], "\[CenterDot]", "\[Sigma]", 
       "\[CenterDot]", 
       SubscriptBox["e", "\[Lambda]"]}]}], "=", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"U", ",", "L"}], "\[RightAngleBracket]"}], 
      SubscriptBox["e", "\[Lambda]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "3b0642a3-cf8c-4c44-a82b-9ad63ef1787e"],
 ". Thus to compute the form \[LeftAngleBracket]U,L\[RightAngleBracket], we \
need only determine the scalar ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Sigma]"], TraditionalForm]],ExpressionUUID->
  "07f48b7f-7011-4e0c-bfbf-fbced2e8b916"],
 ", such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["e", "\[Lambda]"], "\[CenterDot]", "\[Sigma]", 
     "\[CenterDot]", 
     SubscriptBox["e", "\[Lambda]"]}], "=", 
    RowBox[{
     SubscriptBox["A", "\[Sigma]"], 
     SubscriptBox["e", "\[Lambda]"]}]}], TraditionalForm]],ExpressionUUID->
  "aca8e426-e344-43d4-a2b4-3e6c18731bc6"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9461040869188395`*^9, 3.946104118765831*^9}, {
  3.9461041523290944`*^9, 3.9461047112505903`*^9}, {3.9461047416948605`*^9, 
  3.946104838857716*^9}, {3.9461049070959506`*^9, 3.9461051159788866`*^9}, {
  3.9461053124729576`*^9, 3.9461053231382856`*^9}, {3.946105361017663*^9, 
  3.9461056119871645`*^9}, {3.946105720747961*^9, 3.9461057239971647`*^9}, {
  3.946106268350998*^9, 3.9461062779767594`*^9}, {3.9677920751261067`*^9, 
  3.9677920826612663`*^9}},ExpressionUUID->"809664ee-fe82-43ce-95f3-\
f15f3d9590fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PermCalc", "[", 
   RowBox[{"n_", ",", "L_", ",", "U_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Lcups", ",", "Ucups", ",", "Lperm", ",", "Uperm", ",", "l", ",", "a", 
      ",", "b", ",", "c", ",", "d", ",", "lP", ",", "uP", ",", "lE", ",", 
      "lcE", ",", "uE", ",", "ucE", ",", "mE", ",", "f", ",", "G", ",", 
      "PP"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Lcups", "=", 
      RowBox[{"L", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"n", "-", 
       RowBox[{
        RowBox[{"Length", "[", "Lcups", "]"}], "*", "2"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Lperm", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Permute", "[", 
        RowBox[{
         RowBox[{"Range", "[", "l", "]"}], ",", 
         RowBox[{"InversePermutation", "[", 
          RowBox[{"L", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ucups", "=", 
      RowBox[{"U", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Uperm", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Permute", "[", 
        RowBox[{
         RowBox[{"Range", "[", "l", "]"}], ",", 
         RowBox[{"InversePermutation", "[", 
          RowBox[{"U", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "[", "i_", "]"}], ":=", "i"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"b", "[", "i_", "]"}], ":=", 
      RowBox[{"i", "+", "l"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c", "[", "i_", "]"}], ":=", 
      RowBox[{"i", "+", "l", "+", "n"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d", "[", "i_", "]"}], ":=", 
      RowBox[{"i", "+", "l", "+", 
       RowBox[{"2", "*", "n"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lP", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", 
        RowBox[{"Flatten", "[", "Lcups", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uP", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", 
        RowBox[{"Flatten", "[", "Ucups", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", "i", "]"}], "\[UndirectedEdge]", 
         RowBox[{"b", "[", 
          RowBox[{"lP", "[", 
           RowBox[{"[", 
            RowBox[{"Lperm", "[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lcE", "=", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", 
         RowBox[{
          RowBox[{"b", "[", 
           RowBox[{"u", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
          RowBox[{"b", "[", 
           RowBox[{"u", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], "/@", 
       "Lcups"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"Uperm", "[", "i", "]"}], "]"}], "\[UndirectedEdge]", 
         RowBox[{"c", "[", 
          RowBox[{"uP", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ucE", "=", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"u", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
          RowBox[{"c", "[", 
           RowBox[{"u", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], "/@", 
       "Ucups"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"b", "[", "i", "]"}], "\[UndirectedEdge]", 
         RowBox[{"c", "[", "i", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"G", "=", 
      RowBox[{"Graph", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"lE", ",", "lcE", ",", "uE", ",", "ucE", ",", "mE"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PP", "[", "i_", "]"}], ":=", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "==", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"ConnectedComponents", "[", "G", "]"}], "]"}], "-", 
         RowBox[{"Length", "[", 
          RowBox[{"ConnectedComponents", "[", 
           RowBox[{"G", ",", 
            RowBox[{"Union", "[", 
             RowBox[{
              RowBox[{"Range", "[", "l", "]"}], ",", 
              RowBox[{"d", "/@", 
               RowBox[{"Range", "[", "l", "]"}]}]}], "]"}]}], "]"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Max", "/@", 
             RowBox[{"ConnectedComponents", "[", 
              RowBox[{"G", ",", 
               RowBox[{"Range", "[", "l", "]"}]}], "]"}]}], "]"}], "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", "n"}], "+", "l"}], ")"}], "-", "0.5"}], "]"}], 
         "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"ConnectedComponents", "[", 
             RowBox[{"G", ",", 
              RowBox[{"{", "i", "}"}]}], "]"}], "]"}], "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", "n"}], "+", "l"}], ")"}]}], ")"}]}]}], "]"}]}],
      ";", "\[IndentingNewLine]", "PP"}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.946025373154233*^9, 3.946025434033535*^9}, {
   3.9460254706586523`*^9, 3.9460254709221325`*^9}, {3.946025624841051*^9, 
   3.9460256768261805`*^9}, {3.9460257608206406`*^9, 
   3.9460257856232667`*^9}, {3.946025828244911*^9, 3.9460258331524973`*^9}, {
   3.946025880313053*^9, 3.946025913997998*^9}, {3.946025964588275*^9, 
   3.946026016869107*^9}, {3.946026058337128*^9, 3.946026095108619*^9}, {
   3.9460261310505557`*^9, 3.9460261341165347`*^9}, {3.946026175660545*^9, 
   3.9460263580041103`*^9}, {3.9460264721863127`*^9, 3.946026544444189*^9}, {
   3.946026589388194*^9, 3.946026612444476*^9}, {3.9460267977410946`*^9, 
   3.9460268228168583`*^9}, {3.9460268533255625`*^9, 3.94602685368103*^9}, {
   3.946027361195524*^9, 3.9460274075483513`*^9}, {3.946027605654898*^9, 
   3.9460276220805616`*^9}, {3.9460276533227253`*^9, 3.946027762605585*^9}, {
   3.9460278599312716`*^9, 3.946027885846691*^9}, {3.9460279745583*^9, 
   3.9460280943321486`*^9}, {3.9460282706320868`*^9, 
   3.9460282781003714`*^9}, {3.9460283535641913`*^9, 
   3.9460283563504086`*^9}, {3.946028466530842*^9, 3.946028470512148*^9}, {
   3.946028519445922*^9, 3.946028555904676*^9}, {3.9460286566574335`*^9, 
   3.9460286612560854`*^9}, {3.946029381274296*^9, 3.946029460523616*^9}, {
   3.946030437127387*^9, 3.946030461918203*^9}, {3.946031605535078*^9, 
   3.946031720314861*^9}, {3.946031766600605*^9, 3.9460317717127867`*^9}, {
   3.9460321815991755`*^9, 3.9460322498344193`*^9}, {3.946032344377453*^9, 
   3.9460323491554155`*^9}, {3.946032455099639*^9, 3.946032464679702*^9}, {
   3.9461123125406485`*^9, 3.9461123205132265`*^9}, {3.94611246490635*^9, 
   3.9461124904113054`*^9}, {3.9461125476495795`*^9, 3.946112550661438*^9}, {
   3.9461126301009183`*^9, 3.9461126316941133`*^9}, {3.9467056496261835`*^9, 
   3.946705664306963*^9}, 3.946712193841451*^9, {3.946712257037816*^9, 
   3.9467122668611298`*^9}, {3.946712407258519*^9, 3.9467124094383035`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"e0a713ce-f4cb-48bc-b060-891e3ed1802d"],

Cell["\<\
The following two functions, determine the height of a configuration of cups, \
when there is 1 cup (\[OpenCurlyDoubleQuote]Ht1\[CloseCurlyDoubleQuote]) and \
2 cups (\[OpenCurlyDoubleQuote]Ht2\[CloseCurlyDoubleQuote]) respectively.\
\>", "Text",
 CellChangeTimes->{{3.9461056826531534`*^9, 
  3.946105763323392*^9}},ExpressionUUID->"90e71b9d-53ac-4eaa-8445-\
0e332025622c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ht1", "[", 
    RowBox[{"{", "P_", "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "Ht"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{
        RowBox[{"Min", "[", "P", "]"}], "-", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{
        RowBox[{"Max", "[", "P", "]"}], "-", "a", "-", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Ht", "=", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         RowBox[{"Sign", "[", "b", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"a", "+", "b"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      "Ht"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Type", "[", 
    RowBox[{"{", 
     RowBox[{"P1_", ",", "P2_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Sign", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Min", "[", "P1", "]"}], "-", 
           RowBox[{"Min", "[", "P2", "]"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Max", "[", "P1", "]"}], "-", 
           RowBox[{"Max", "[", "P2", "]"}]}], ")"}]}], "]"}]}], ")"}], "/", 
     "2"}], "+", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Min", "[", "P2", "]"}], "-", 
          RowBox[{"Max", "[", "P1", "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Max", "[", "P2", "]"}], "-", 
          RowBox[{"Max", "[", "P1", "]"}]}], ")"}]}], "]"}]}], ")"}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ht2", "[", 
   RowBox[{"{", 
    RowBox[{"P1_", ",", "P2_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "d", ",", "P", ",", "T", ",", "Ht"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"P", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"P1", ",", "P2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"T", "=", 
      RowBox[{"Type", "[", 
       RowBox[{"{", 
        RowBox[{"P1", ",", "P2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"P", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "-", 
       RowBox[{"P", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "-", 
       RowBox[{"P", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ht", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"T", "-", "1"}], ")"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"T", "-", "2"}], ")"}], "/", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           RowBox[{"Sign", "[", 
            RowBox[{"b", "+", "d"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"a", "+", "b", "+", 
             RowBox[{
              RowBox[{"Sign", "[", "d", "]"}], "*", "c"}], "+", "d"}], 
            ")"}]}]}], ")"}]}], "-", 
       RowBox[{"T", "*", 
        RowBox[{"(", 
         RowBox[{"T", "-", "2"}], ")"}], "*", 
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           RowBox[{"Sign", "[", 
            RowBox[{"b", "+", "c", "+", "d"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"a", "+", "b", "+", "c", "+", 
             RowBox[{
              RowBox[{"Sign", "[", "c", "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Sign", "[", "d", "]"}]}], ")"}]}], "+", "d"}], 
            ")"}]}]}], ")"}]}], "+", 
       RowBox[{"T", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"T", "-", "1"}], ")"}], "/", "2"}], "*", 
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{"a", "+", "b", "+", "c", "+", "d", "-", 
          RowBox[{"Sign", "[", "d", "]"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", "Ht"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.946105669967839*^9, 3.9461056706160336`*^9}, {
  3.9461057687672215`*^9, 3.946105851548091*^9}, {3.9461059010564137`*^9, 
  3.9461059678275394`*^9}, {3.946113553681624*^9, 3.946113554814269*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"56c14611-30b0-47c3-a332-83bd6b921025"],

Cell[TextData[{
 "We now give two functions below, whose input is a rank n, and a list of \
cups, and computes the gram-matrix of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"K", "-", "module"}], "\[Subset]", 
    SubscriptBox[
     SubscriptBox["\[CapitalDelta]", 
      RowBox[{"p", ",", "\[Lambda]"}]], "\[IndentingNewLine]"]}], 
   TraditionalForm]],ExpressionUUID->"d9083b14-4d82-4f76-b16c-b0337bc1df11"],
 " spanned by the corresponding cup diagrams, where \[Lambda] is the row, \
column, 21, 22, and 31 partition respectively."
}], "Text",
 CellChangeTimes->{{3.946106236250413*^9, 3.946106249534485*^9}, {
  3.9461062893386602`*^9, 3.9461063495629873`*^9}, {3.9461063898975887`*^9, 
  3.946106576716742*^9}, {3.946106607672597*^9, 3.946106666675993*^9}, {
  3.9918296902031183`*^9, 
  3.9918297720814915`*^9}},ExpressionUUID->"739effa2-3b79-4870-9c9b-\
e99c72cb8edf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GramRow", "[", 
    RowBox[{"n_", ",", "Cups_", ",", "\[Delta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "d", ",", "GM", ",", "P0", ",", "P"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"n", "-", 
        RowBox[{"2", "*", 
         RowBox[{"Length", "[", 
          RowBox[{"Cups", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"Length", "[", "Cups", "]"}]}], ";", "\n", 
      RowBox[{"P0", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PermCalc", "[", 
            RowBox[{"n", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cups", "[", 
                RowBox[{"[", "#1", "]"}], "]"}], ",", 
               RowBox[{"Range", "[", "p", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cups", "[", 
                RowBox[{"[", "#2", "]"}], "]"}], ",", 
               RowBox[{"Range", "[", "p", "]"}]}], "}"}]}], "]"}], "[", "0", 
           "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Signature", "[", 
           RowBox[{
