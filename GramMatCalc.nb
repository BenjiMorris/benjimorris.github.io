   3.9677176951907034`*^9, 3.967717725187624*^9}, {3.967717826768594*^9, 
   3.967717852903695*^9}, {3.967718302568217*^9, 3.9677183036526375`*^9}, {
   3.967781566266915*^9, 3.9677815676545115`*^9}, {3.967781660642356*^9, 
   3.967781676740728*^9}, {3.967782128060643*^9, 3.9677821291895123`*^9}, {
   3.9739253875059805`*^9, 3.9739254708363495`*^9}, {3.9918298210824714`*^9, 
   3.991829821419467*^9}},ExpressionUUID->"9111bce5-243f-4fda-85ce-\
76ca3d152583"],

Cell["\<\
Below we write functions to compute all 1 and 2 cup configurations of rank n, \
and height at most l.\
\>", "Text",
 CellChangeTimes->{{3.946554381271179*^9, 
  3.9465544122773714`*^9}},ExpressionUUID->"4a291269-e4c4-40f2-bd65-\
d943367862d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Cups1", "[", 
    RowBox[{"n_", ",", "l_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"S", ",", "SS", ",", "SSS"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"S", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Range", "[", "n", "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SS", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "#", "}"}], "&"}], "/@", "S"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SSS", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"SS", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Ht1", "[", "#", "]"}], "<=", "l"}], "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "SSS"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Cups2", "[", 
   RowBox[{"n_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"S", ",", "SS", ",", "SSS"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"S", "=", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", 
        RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"SS", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "}"}], "&"}], "/@", 
         "S"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "}"}], "&"}], "/@", 
         "S"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}], "&"}], "/@", 
         "S"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"SSS", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"SS", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Ht2", "[", "#", "]"}], "<=", "l"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "SSS"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9465529531849823`*^9, 3.946553037335146*^9}, {
  3.9465543688489466`*^9, 3.9465543696834626`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"34e6dda2-6d7b-4986-a67e-2a68b1827ab2"],

Cell[TextData[{
 "Using the above functions, we compute below the gram matrices of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", 
    RowBox[{"l", ",", "n"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "443ecd60-8d0e-45ce-8182-bf8f8c706329"],
 " standard modules ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    RowBox[{
     RowBox[{"n", "-", "2"}], ",", "\[Lambda]"}]], TraditionalForm]],
  ExpressionUUID->"6f77d8b3-9c5e-4063-b08c-cea6ec9facd4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    RowBox[{
     RowBox[{"n", "-", "4"}], ",", "\[Lambda]"}]], TraditionalForm]],
  ExpressionUUID->"9ac59092-4be8-4b8b-a7fd-96d6396132a5"],
 " (who have bases described by 1 and 2 cup configurations of rank n,height \
\[LessEqual] l respectively), where \[Lambda] is the appropriate row/column \
partition. "
}], "Text",
 CellChangeTimes->{{3.9465544212614603`*^9, 3.9465544415664644`*^9}, {
  3.946554485138878*^9, 
  3.94655461250286*^9}},ExpressionUUID->"df8d60ad-8709-4d82-95be-\
baad869f04fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"GRRow1", "[", 
   RowBox[{"n_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"GramRow", "[", 
   RowBox[{"n", ",", 
    RowBox[{"Cups1", "[", 
     RowBox[{"n", ",", "l"}], "]"}], ",", "\[Delta]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GRCol1", "[", 
   RowBox[{"n_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"GramCol", "[", 
   RowBox[{"n", ",", 
    RowBox[{"Cups1", "[", 
     RowBox[{"n", ",", "l"}], "]"}], ",", "\[Delta]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GRRow2", "[", 
   RowBox[{"n_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"GramRow", "[", 
   RowBox[{"n", ",", 
    RowBox[{"Cups2", "[", 
     RowBox[{"n", ",", "l"}], "]"}], ",", "\[Delta]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GRCol2", "[", 
   RowBox[{"n_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"GramCol", "[", 
   RowBox[{"n", ",", 
    RowBox[{"Cups2", "[", 
     RowBox[{"n", ",", "l"}], "]"}], ",", "\[Delta]"}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9461152894769535`*^9, 3.9461153371928716`*^9}, {
  3.9461154868538227`*^9, 3.9461154949169207`*^9}, {3.946553064287153*^9, 
  3.9465530772161026`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"e710f140-28c3-45c2-a23d-2af135fb0b83"]
},
