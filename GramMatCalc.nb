             RowBox[{"n", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cups", "[", 
                 RowBox[{"[", "#1", "]"}], "]"}], ",", 
                RowBox[{"Range", "[", "p", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cups", "[", 
                 RowBox[{"[", "#2", "]"}], "]"}], ",", 
                RowBox[{"Range", "[", "p", "]"}]}], "}"}]}], "]"}], "/@", 
            RowBox[{"Range", "[", "p", "]"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GM", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]", "^", 
            RowBox[{"(", 
             RowBox[{"P0", "[", 
              RowBox[{"[", 
               RowBox[{"#1", ",", "#2"}], "]"}], "]"}], ")"}]}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"P", "[", 
              RowBox[{"[", 
               RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "^", "2"}], ")"}]}], 
          "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "GM"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
